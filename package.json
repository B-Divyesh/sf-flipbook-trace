{
  "name": "flipbook-trace",
  "private": true,
  "version": "1.0.16",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts playwright.config.ts vitest.config.ts",
    "build": "npm run typecheck && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "eslint": "10.9.1",
    "jpeg-js": "^0.4.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
